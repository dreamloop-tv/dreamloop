{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dreamloop",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "routes": [
    { "pattern": "dreamloop.tv", "custom_domain": true },
    { "pattern": "www.dreamloop.tv", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dreamloop",
      "database_id": "4fdf7610-6449-465c-9284-79647aad7e4c",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "VIDEOS",
      "bucket_name": "dreamloop-videos"
    }
  ]
}
